# Set to "true" to enable API calls (requires VITE_API_BASE_URL)
# Default is "false" - uses local mock data with no network requests
VITE_USE_API=false

# Leave empty to use the Vite dev proxy (/api -> http://localhost:4000)
# Set to the deployed API origin for production builds, e.g. https://api.noortailor.com
VITE_API_BASE_URL=
